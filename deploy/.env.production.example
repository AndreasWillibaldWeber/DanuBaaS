# No credentials or working deployment defaults are supplied for production.
# Copy to .env.production. Use literal KEY=value lines; no shell interpolation.
# Set four distinct public DNS hostnames and the MQTT certificate's DNS hostname.
API_HOST=
GRAFANA_HOST=
NODE_RED_HOST=
NODE_RED_API_HOST=
MQTT_HOST=
CADDY_USER=
DASHBOARD_USER=
NODE_RED_ADMIN_USER=
GRAFANA_ADMIN_USER=
INGESTION_BACKEND=
# Absolute directories provisioned by the operator, outside this repository.
SECRETS_DIR=
MQTT_CERTS_DIR=

# Explicit interval (1..3600 seconds) and absolute initial-rule JSON file.
# Use alerts.production.example.json for an empty, uncalibrated installation.
ALERT_EVALUATION_SECONDS=
ALERT_RULES_FILE=
