    "z": "7f70b1c1a742f385",
    "name": "Attach internal API key",
    "func": "const parts=msg.topic.split(\"/\");\nconst values=Array.isArray(msg.payload)?msg.payload:[msg.payload];\nif (!values.length || values.some(v => !v || v.gateway_id !== parts[2] || v.sensor_id !== parts[3])) { node.warn(\"MQTT payload identity does not match topic\"); return null; }\nmsg.method=\"POST\";\nmsg.url=\"http://api:8080/api/v1/values\";\nmsg.headers={\"X-API-Key\":global.get(\"apiKey\"),\"Content-Type\":\"application/json\"};\nreturn msg;",
