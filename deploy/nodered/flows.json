  {
    "id": "174b62c53e07a0d9",
    "type": "function",
    "z": "7f70b1c1a742f385",
    "name": "Select ingestion backend",
    "func": "const ingestion = global.get(\"ingestion\");\nif (ingestion.backend === \"api\") {\n    return msg.req ? [msg, null, null] : [null, msg, null];\n}\nif (msg.req) {\n    if (msg.req.originalUrl.includes(\"?\")) {\n        msg.statusCode=400; msg.payload={error:{code:\"invalid_query\",message:\"POST does not accept query parameters\"}};\n        return [null,null,msg];\n    }\n    if ((msg.req.headers[\"content-type\"] || \"\").split(\";\")[0].trim().toLowerCase() !== \"application/json\") {\n        msg.statusCode=415; msg.payload={error:{code:\"unsupported_media_type\",message:\"Content-Type must be application/json\"}};\n        return [null,null,msg];\n    }\n}\ntry {\n    const result = await ingestion.publish(msg.payload);\n    if (!msg.req) return null;\n    msg.statusCode=202; msg.payload=result;\n} catch (error) {\n    if (!msg.req) { node.warn(error.message); return null; }\n    msg.statusCode=error.status || 503;\n    msg.payload={error:{code:msg.statusCode===503?\"broker_unavailable\":\"invalid_value\",message:error.message}};\n}\nmsg.headers={\"Content-Type\":\"application/json\",\"Cache-Control\":\"no-store\"};\nreturn [null,null,msg];",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
