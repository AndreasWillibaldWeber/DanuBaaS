    "func": "if (!Number.isInteger(msg.statusCode)) { msg.statusCode=503; msg.payload={error:{code:\"storage_unavailable\",message:\"API unavailable; retry with the same IDs\"}}; }\nconst upstream = msg.headers || {};\nmsg.headers = {\"Content-Type\":\"application/json\", \"Cache-Control\":\"no-store\"};\nfor (const k of [\"link\", \"x-next-cursor\", \"location\", \"allow\"]) if (upstream[k]) msg.headers[k] = upstream[k];\nreturn msg;",
