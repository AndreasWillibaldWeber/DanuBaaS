  {
    "id": "bfface43bab677ca",
    "type": "function",
    "z": "7f70b1c1a742f385",
    "name": "Maintain latest 100 values",
    "func": "if (msg.statusCode !== 200 || !Array.isArray(msg.payload)) return null;\nlet rows=context.get(\"rows\") || [];\nconst byId=new Map(rows.map(r=>[r.id,r]));\nfor (const row of msg.payload) byId.set(row.id,row);\nrows=Array.from(byId.values()).sort((a,b)=>b.sequence-a.sequence).slice(0,100);\ncontext.set(\"rows\",rows);\n// Cursor belongs to flow context so the next poll advances through all pages.\nif (rows.length) flow.set(\"dashboardCursor\",rows[0].sequence);\nmsg.payload=rows;\nmsg.headers={};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
