# Defaults work locally using Caddy's local CA. Production: use real DNS names.
API_HOST=api.localhost
GRAFANA_HOST=grafana.localhost
NODE_RED_HOST=nodered.localhost
NODE_RED_API_HOST=flows.localhost
CADDY_USER=viewer
DASHBOARD_USER=operator
NODE_RED_ADMIN_USER=admin
GRAFANA_ADMIN_USER=admin

# api: synchronous Go API writes; mqtt: Mosquitto -> Telegraf -> TimescaleDB
INGESTION_BACKEND=api

# Scheduler interval; thresholds are initially loaded from alerts.json, then managed by API.
ALERT_EVALUATION_SECONDS=30
ALERT_RULES_FILE=./alerts.json
